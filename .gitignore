# General Node.js and JavaScript/TypeScript project ignores

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.exn
report.staging.[0-9]*.[0-9]*.[0-9]*.[0-9]*.exn

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
.coverage
coverage
*.lcov

# nyc test coverage
.nyc_output

# Temporary files and directories
.temp
tmp
*.tmp
*.swp
.DS_Store
Thumbs.db
._*
*.DS_Store
.AppleDouble
.LSOverride
ehthumbs.db
*.lnk

# dotenv environment variables file
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.production

# next.js folder
.next/
# out/

# node_modules
node_modules/

# Packages lock files (already implicitly ignored by node_modules, but good to be explicit if you ever decide to not ignore node_modules)
yarn.lock
pnpm-lock.yaml

# IDE and editor specific files
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# WebStorm
.idea/*

# Include workspace settings
!.idea/codeStyles
!.idea/inspectionProfiles
!.idea/dictionaries/doasync.xml
!.idea/compiler.xml
!.idea/jsLibraryMappings.xml
!.idea/misc.xml
!.idea/modules.xml
!.idea/vcs.xml

# Project
!.idea/project.iml
