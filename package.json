{
  "name": "chat-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs 2>/dev/null || true && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs 2>/dev/null || true",
    "qa": "npm run ts && npm run lint && npm run codestyle && npm run deps && npm run test",
    "fix": "npm run eslint --fix && npm run format",
    "eslint": "eslint '**/*.{js,jsx,ts,tsx}' --quiet",
    "format": "prettier '**/*' --write --ignore-unknown --log-level warn",
    "codestyle": "prettier '**/*' --check --ignore-unknown",
    "deps": "madge --ts-config tsconfig.json --warning --circular src/app/page.tsx",
    "ts": "tsc -p tsconfig.json",
    "ts-files": "tsc --listFiles -p tsconfig.json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.2.5",
    "@lightenna/react-mermaid-diagram": "^1.0.17",
    "@mui/icons-material": "^7.0.1",
    "@mui/material": "^7.0.1",
    "@tanstack/react-query": "^5.71.10",
    "dompurify": "^3.2.6",
    "effector": "^23.3.0",
    "effector-react": "^23.3.0",
    "effector-storage": "^7.1.0",
    "eventsource-parser": "^3.0.1",
    "idb": "^8.0.2",
    "jszip": "^3.10.1",
    "katex": "^0.16.21",
    "localforage": "^1.10.0",
    "mammoth": "^1.9.1",
    "mermaid": "^11.6.0",
    "next": "15.2.4",
    "patronum": "^2.3.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.3.31",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-draggable": "^4.4.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "turndown": "^7.2.0",
    "use-long-press": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/turndown": "^5.0.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.2.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-effector": "^0.15.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.13.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mdx": "^3.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^55.0.0",
    "globals": "^16.2.0",
    "madge": "^8.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5"
  }
}
