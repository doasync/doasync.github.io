import { dirname } from "path";
import { fileURLToPath } from "url";
import { FlatCompat } from "@eslint/eslintrc";
import js from "@eslint/js";
import globals from "globals";
import typescriptEslint from "@typescript-eslint/eslint-plugin";
import typescriptParser from "@typescript-eslint/parser";
import unicorn from "eslint-plugin-unicorn";
// import jest from "eslint-plugin-jest"; // Not needed - project doesn't use Jest
import importPlugin from "eslint-plugin-import";
import react from "eslint-plugin-react";
import reactHooks from "eslint-plugin-react-hooks";
import jsxA11y from "eslint-plugin-jsx-a11y";
import * as mdx from "eslint-plugin-mdx";
import simpleImportSort from "eslint-plugin-simple-import-sort";
import effector from "eslint-plugin-effector";
import prettierConfig from "eslint-config-prettier";

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

const compat = new FlatCompat({
  baseDirectory: __dirname,
  recommendedConfig: js.configs.recommended,
});

const eslintConfig = [
  // Global ignores - converted from .eslintignore
  {
    ignores: [
      // TS
      ".typescript/**",
      
      // Dependencies
      "node_modules/**",
      
      // Ignore npm lock (use yarn.lock)
      "package-lock.json",
      
      // Build files
      "build/**",
      "dist/**",
      "storybook-static/**",
      ".next/**",
      "out/**",
      
      // Misc
      ".coverage/**",
      ".temp/**",
      ".npm/**",
      ".cache/**",
      ".*-cache/**",
      
      // DotEnv
      ".env",
      
      // VSCode
      ".vscode/**",
      
      // WebStorm
      ".idea/**",
      
      // System
      "**/*.DS_Store",
      "**/.AppleDouble",
      "**/.LSOverride",
      "**/Thumbs.db",
      "**/ehthumbs.db",
      "**/*.lnk",
      
      // Logs
      "**/*.log",
      "**/npm-debug.log*",
      "**/yarn-debug.log*",
      "**/yarn-error.log*",
      
      // Other
      "suruden-ai-project/**",
      
      // Storybook exception
      "!.storybook/**"
    ]
  },

  // Base JavaScript configuration
  js.configs.recommended,

  // Next.js configs
  ...compat.extends("next/core-web-vitals", "next/typescript"),

  // TypeScript configs
  ...compat.extends(
    "plugin:@typescript-eslint/recommended",
    "plugin:@typescript-eslint/recommended-requiring-type-checking"
  ),

  // Jest config - commented out since project doesn't use Jest
  // ...compat.extends("plugin:jest/recommended"),

  // Import plugin config
  ...compat.extends("plugin:import/typescript"),

  // Effector plugin config - DISABLED due to ESLint 9 compatibility issues
  // The eslint-plugin-effector@0.1.4 doesn't support ESLint 9's flat config
  // and newer versions require ESLint 7 or 8. 
  // TODO: Re-enable when the plugin supports ESLint 9
  // ...compat.plugins("effector"),
  // ...compat.config({
  //   rules: {
  //     "effector/enforce-store-naming-convention": "error",
  //     "effector/enforce-effect-naming-convention": "error",
  //     "effector/no-getState": "error",
  //     "effector/no-unnecessary-duplication": "warn",
  //   },
  // }),

  // Prettier config (should be near the end)
  ...compat.extends("prettier"),

  // Global configuration for all files
  {
    files: ["**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx", "**/*.mjs", "**/*.cjs"],
    
    languageOptions: {
      ecmaVersion: 2020,
      sourceType: "module",
      parser: typescriptParser,
      parserOptions: {
        project: "./tsconfig.json",
        tsconfigRootDir: __dirname,
        extraFileExtensions: [".mdx"],
        ecmaFeatures: {
          jsx: true,
        },
      },
      globals: {
        ...globals.browser,
        ...globals.node,
        // ...globals.jest, // Not needed - project doesn't use Jest
        ...globals.es2020,
      },
    },

    plugins: {
      unicorn,
      "simple-import-sort": simpleImportSort,
      react,
      "react-hooks": reactHooks,
      "jsx-a11y": jsxA11y,
      mdx,
    },

    settings: {
      "import/resolver": {
        typescript: {
          alwaysTryTypes: true,
        },
        node: {
          paths: ["src"],
        },
      },
      react: {
        version: "detect",
      },
    },

    rules: {
      // Unicorn rules
      ...unicorn.configs['flat/recommended'].rules,
      "unicorn/prevent-abbreviations": [
        "error",
        {
          allowList: {
            args: true,
            ref: true,
            Ref: true,
            props: true,
            Props: true,
            dev: true,
            Dev: true,
            prod: true,
            Prod: true,
            env: true,
            Env: true,
            params: true,
            Params: true,
            param: true,
            Param: true,
            config: true,
            Config: true,
          },
        },
      ],
      "unicorn/no-null": "off",
      "unicorn/no-fn-reference-in-iterator": "off",

      // React rules
      "react/jsx-filename-extension": ["error", { extensions: [".jsx", ".tsx"] }],
      "react/require-default-props": [
        "warn",
        {
          forbidDefaultForRequired: true,
          ignoreFunctionalComponents: true,
        },
      ],

      // Import rules
      "import/extensions": [
        "error",
        "ignorePackages",
        {
          js: "never",
          mjs: "never",
          jsx: "never",
          ts: "never",
          tsx: "never",
        },
      ],
      "import/no-extraneous-dependencies": [
        "error",
        {
          devDependencies: [
            "./*.js",
            "webpack/**/*.ts",
            "src/**/*.test.js",
            "src/**/*.test.ts",
            "src/**/*.stories.ts",
            "src/**/*.stories.tsx",
            "src/**/*.stories.mdx",
            "src/lib/storybook-kit/**/*.ts",
            ".storybook/*.ts",
          ],
        },
      ],
      "import/prefer-default-export": "off",
      "import/no-default-export": "error",

      // General rules
      "no-plusplus": ["error", { allowForLoopAfterthoughts: true }],
      "no-restricted-syntax": [
        "error",
        "LabeledStatement",
        "WithStatement",
        "SequenceExpression",
      ],
      "no-restricted-imports": ["error", { patterns: ["../*", "~/@/*"] }],

      // TypeScript rules
      "@typescript-eslint/comma-dangle": "off",
    },
  },

  // TypeScript file overrides with import sorting
  {
    files: ["**/*.ts", "**/*.tsx"],
    rules: {
      // Import sorting rules
      "sort-imports": "off",
      "import/order": "off",
      "simple-import-sort/imports": [
        "error",
        {
          groups: [
            // Side effect imports.
            ["^\\u0000"],
            // Packages
            ["^@?\\w"],
            // Absolute imports
            ["^[^.]"],
            // Features
            ["^@/\\w"],
            // Relative imports
            ["^\\."],
          ],
        },
      ],
      "simple-import-sort/exports": "error",
      "import/first": "error",
      "import/newline-after-import": "error",
      "import/no-duplicates": "error",
    },
  },

  // TSX files specific rules
  {
    files: ["src/**/*.tsx"],
    rules: {
      "@typescript-eslint/explicit-module-boundary-types": "off",
    },
  },

  // Config files, type definitions, and Next.js files
  {
    files: [
      ".storybook/**/*.ts",
      "webpack/**/*.ts",
      "**/*.d.ts",
      "**/*.config.js",
      "**/*.config.mjs",
      "**/*.config.ts",
      "next.config.mjs",
      "src/app/**/page.tsx",
      "src/app/**/layout.tsx",
      "src/app/**/error.tsx",
      "src/app/**/loading.tsx",
      "src/app/**/not-found.tsx",
      "src/app/**/default.tsx",
      "src/app/**/template.tsx",
      "src/app/**/(auth)/*.tsx",
      "src/app/api/**/*.ts",
    ],
    rules: {
      "import/no-default-export": "off",
    },
  },

  // Storybook files
  {
    files: ["src/**/*.stories.ts", "src/**/*.stories.tsx"],
    rules: {
      "import/no-default-export": "off",
      "@typescript-eslint/consistent-type-assertions": "off",
      "react/jsx-props-no-spreading": "off",
    },
  },

  // MDX files
  {
    files: ["src/**/*.mdx"],
    ...compat.extends("plugin:mdx/recommended")[0],
    rules: {
      // Disable all TypeScript rules for MDX files
      ...Object.keys(typescriptEslint.rules).reduce((acc, rule) => {
        acc[`@typescript-eslint/${rule}`] = "off";
        return acc;
      }, {}),
      
      // Custom MDX rules
      "react/jsx-filename-extension": ["error", { extensions: [".mdx"] }],
      "react/no-unknown-property": ["error", { ignore: ["class"] }],
      "react/jsx-no-target-blank": "off",
    },
  },

  // Apply prettier config last to override formatting rules
  prettierConfig,
];

export default eslintConfig;