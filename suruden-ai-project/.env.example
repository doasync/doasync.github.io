# Переменные для VoidAI API
VOIDAI_API_KEYS=YOUR_VOIDAI_API_KEY_HERE
AVAILABLE_MODELS=Gemini 2.5 Pro:gemini-2.5-pro-preview-03-25,o3-high:o3-high,o4-mini high:o4-mini-high,Grok 3:grok-3-latest,GPT 4.1:gpt-4.1,GPT-4o:chatgpt-4o-latest

# --- Настройки Стриминга ---
# Перечислить ID моделей (из AVAILABLE_MODELS), для которых стриминг ОТКЛЮЧЕН
VOIDAI_NON_STREAMING_MODELS=grok-3

# Базовый URL для VoidAI API (из документации)
VOIDAI_BASE_URL=https://api.voidai.app/v1

# --- Настройки Telegram Бота ---
# Токен твоего бота (получи у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# Твой числовой ID в Telegram (и ID других админов через запятую)
# Можешь узнать свой ID у бота @userinfobot
TELEGRAM_ADMIN_IDS=123456789

# --- Настройки Базы Данных ---
# Путь к файлу базы данных SQLite. './data/' означает папку data в корне проекта.
DATABASE_URL=sqlite+aiosqlite:///./data/chats.db

# --- Секретный Ключ FastAPI ---
# Обязательно замени на свою СЛУЧАЙНУЮ СТРОКУ!
# Сгенерировать можно командой: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_SECRET_KEY_HERE

# --- Настройки Сервера (опционально) ---
# HOST="0.0.0.0"  # Для запуска на VPS (слушать все адреса)
# PORT=8000       # Стандартный порт
