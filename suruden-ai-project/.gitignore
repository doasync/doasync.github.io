# Виртуальное окружение Python
venv/
.venv/
env/
ENV/
*.pyc
__pycache__/

# Файлы IDE (VSCode, PyCharm и т.д.)
.vscode/
.idea/
*.swp
*.swo

# Файлы операционной системы
.DS_Store
Thumbs.db

# Файл переменных окружения (НИКОГДА не добавлять в Git!)
.env

# База данных SQLite (обычно не хранят в Git, особенно если она часто меняется)
/data/*.db
/data/*.db-journal # Файлы журнала SQLite

# Логи
*.log

# Загруженные пользователем файлы (если будут временно сохраняться)
/uploads/ # Пример, если ты решишь создать такую папку

# Директории сборки Python
build/
dist/
*.egg-info/

# Отчеты о покрытии кода
.coverage
coverage.xml
htmlcov/